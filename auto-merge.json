{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"description": "shareable configuration to enable automerge for renovate",
	"platformAutomerge": true,
	"packageRules": [
		{
			"description": "Automerge non-major updates of stable packages",
			"matchUpdateTypes": ["minor", "patch", "pin", "pinDigest"],
			"matchCurrentVersion": "!/^v?0/",
			"automerge": true
		},
		{
			"description": "Automerge every update of devDependencies",
			"matchDepTypes": ["devDependencies"],
			"automerge": true
		}
	]
}
